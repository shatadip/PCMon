<UserControl x:Class="PCMon.Views.UnusedAppsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:PCMon.Core">
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <Button DockPanel.Dock="Right" Command="{Binding UninstallSelectedCommand}" Style="{StaticResource AccentButton}" Margin="10,0,0,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE74D;" Style="{StaticResource Glyph}" />
                    <TextBlock Text="Uninstall selected" Margin="8,0,0,0" />
                </StackPanel>
            </Button>
            <Button DockPanel.Dock="Right" Command="{Binding LoadCommand}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE72C;" Style="{StaticResource Glyph}" />
                    <TextBlock Text="Refresh" Margin="8,0,0,0" />
                </StackPanel>
            </Button>
            <StackPanel>
                <TextBlock Text="Unused apps" Style="{StaticResource PageTitle}" />
                <TextBlock Text="{Binding Summary}" Style="{StaticResource Dim}" Margin="0,2,0,0" />
            </StackPanel>
        </DockPanel>

        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <CheckBox DockPanel.Dock="Right" Content="Include apps with unknown usage" IsChecked="{Binding IncludeUnknown}" />
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Not opened in" Style="{StaticResource Dim}" Margin="0,0,10,0" />
                <RadioButton Content="30 days" Style="{StaticResource Chip}" GroupName="Days"
                             IsChecked="{Binding Days, Converter={StaticResource Equals}, ConverterParameter=30}" />
                <RadioButton Content="60 days" Style="{StaticResource Chip}" GroupName="Days"
                             IsChecked="{Binding Days, Converter={StaticResource Equals}, ConverterParameter=60}" />
                <RadioButton Content="90 days" Style="{StaticResource Chip}" GroupName="Days"
                             IsChecked="{Binding Days, Converter={StaticResource Equals}, ConverterParameter=90}" />
                <RadioButton Content="180 days" Style="{StaticResource Chip}" GroupName="Days"
                             IsChecked="{Binding Days, Converter={StaticResource Equals}, ConverterParameter=180}" />
                <RadioButton Content="Show all" Style="{StaticResource Chip}" GroupName="Days"
                             IsChecked="{Binding Days, Converter={StaticResource Equals}, ConverterParameter=0}" />
            </StackPanel>
        </DockPanel>

        <Grid>
            <DataGrid ItemsSource="{Binding Apps}" AutomationProperties.Name="Unused apps">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="36" CanUserSort="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                          AutomationProperties.Name="{Binding Name}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2.2*" />
                    <DataGridTextColumn Header="Publisher" Binding="{Binding Publisher}" Width="1.4*" />
                    <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="100" />
                    <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" Width="90" SortMemberPath="SizeBytes"
                                        ElementStyle="{StaticResource RightCell}" />
                    <DataGridTextColumn Header="Installed" Binding="{Binding InstalledText}" Width="100" SortMemberPath="InstalledSort" />
                    <DataGridTemplateColumn Header="Last used" Width="150" SortMemberPath="LastUsedSort">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding LastUsedText}" ToolTip="{Binding LastUsedTooltip}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Text="{x:Static core:Strings.NoUnusedApps}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{DynamicResource DimBrush}"
                       Visibility="{Binding ShowEmpty, Converter={StaticResource BoolToVisibility}}" />
        </Grid>
    </DockPanel>
</UserControl>
