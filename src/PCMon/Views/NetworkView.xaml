<UserControl x:Class="PCMon.Views.NetworkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:PCMon.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" MaxHeight="170" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="Network" Style="{StaticResource PageTitle}" Margin="0,0,0,12" />

        <DataGrid Grid.Row="1" ItemsSource="{Binding Adapters}" SelectedItem="{Binding SelectedAdapter}"
                  AutomationProperties.Name="Network adapters">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Adapter" Binding="{Binding Name}" Width="2*" />
                <DataGridTextColumn Header="Type" Binding="{Binding Kind}" Width="90" />
                <DataGridTextColumn Header="IPv4" Binding="{Binding Ipv4}" Width="130" />
                <DataGridTextColumn Header="↓ Now" Binding="{Binding DownText}" Width="100" ElementStyle="{StaticResource RightCell}" />
                <DataGridTextColumn Header="↑ Now" Binding="{Binding UpText}" Width="100" ElementStyle="{StaticResource RightCell}" />
                <DataGridTextColumn Header="↓ Total" Binding="{Binding TotalDownText}" Width="100" ElementStyle="{StaticResource RightCell}" />
                <DataGridTextColumn Header="↑ Total" Binding="{Binding TotalUpText}" Width="100" ElementStyle="{StaticResource RightCell}" />
            </DataGrid.Columns>
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                    <Setter Property="ToolTip" Value="{Binding Description}" />
                </Style>
            </DataGrid.RowStyle>
        </DataGrid>

        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,12,0,12" Padding="14,10">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Rectangle Width="10" Height="3" Fill="{DynamicResource DownBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="Download" Style="{StaticResource Dim}" Margin="6,0,14,0" />
                        <Rectangle Width="10" Height="3" Fill="{DynamicResource UpBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="Upload" Style="{StaticResource Dim}" Margin="6,0,0,0" />
                    </StackPanel>
                    <TextBlock Text="{Binding ChartCaption}" Style="{StaticResource Dim}" TextTrimming="CharacterEllipsis" />
                </DockPanel>
                <c:Sparkline Height="120" Values="{Binding ChartDown}" Values2="{Binding ChartUp}" Capacity="120"
                             Stroke="{DynamicResource DownBrush}" Stroke2="{DynamicResource UpBrush}"
                             AutomationProperties.Name="Two minute traffic chart" />
            </DockPanel>
        </Border>

        <DockPanel Grid.Row="3" Margin="0,0,0,8">
            <CheckBox DockPanel.Dock="Right" Content="Hide listening ports" IsChecked="{Binding HideListening}" />
            <TextBlock Text="TCP connections" FontWeight="SemiBold" VerticalAlignment="Center" />
            <TextBlock Text="{Binding ConnectionSummary}" Style="{StaticResource Dim}" Margin="10,0,0,0" />
        </DockPanel>

        <DataGrid Grid.Row="4" ItemsSource="{Binding Connections}" AutomationProperties.Name="TCP connections">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Process" Binding="{Binding Process}" Width="*" />
                <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="70" ElementStyle="{StaticResource RightCell}" />
                <DataGridTextColumn Header="Local" Binding="{Binding Local}" Width="170" />
                <DataGridTextColumn Header="Remote" Binding="{Binding Remote}" Width="190" />
                <DataGridTextColumn Header="State" Binding="{Binding State}" Width="110" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
